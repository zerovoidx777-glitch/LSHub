local ESPHighlightToggle = Tabs.ESP:AddToggle("ESPHighlight", { Title = "Player Highlight (สแกนเรืองแสง)", Default = false })
local ESPNameToggle = Tabs.ESP:AddToggle("ESPName", { Title = "Player Name & Distance (สแกนชื่อ/ระยะทาง)", Default = false })

local ESPColorPicker = Tabs.ESP:AddColorpicker("ESPColor", {
    Title = "ESP Color (สีสแกน)",
    Default = Color3.fromRGB(255, 0, 0)
})

local function ApplyESP(player)
    if player == LocalPlayer then return end

    local function CharacterAdded(char)
        -- 1. Highlight ESP
        if not char:FindFirstChild("LS_Highlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "LS_Highlight"
            highlight.Adornee = char
            highlight.FillColor = ESPColorPicker.Value
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Enabled = ESPHighlightToggle.Value
            pcall(function() highlight.Parent = char end)
        end

        -- 2. Name / Distance ESP
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hrp and not hrp:FindFirstChild("LS_NameESP") then
            local bb = Instance.new("BillboardGui")
            bb.Name = "LS_NameESP"
            bb.Adornee = hrp
            bb.Size = UDim2.new(0, 100, 0, 40)
            bb.StudsOffset = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop = true
            bb.Enabled = ESPNameToggle.Value

            local lbl = Instance.new("TextLabel")
            lbl.Name = "InfoLabel"
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.TextColor3 = ESPColorPicker.Value
            lbl.TextStrokeTransparency = 0
            lbl.TextSize = 13
            lbl.Font = Enum.Font.SourceSansBold
            lbl.Text = player.Name
            lbl.Parent = bb

            pcall(function() bb.Parent = hrp end)
        end
    end

    if player.Character then
        CharacterAdded(player.Character)
    end
    player.CharacterAdded:Connect(CharacterAdded)
end

for _, p in ipairs(Players:GetPlayers()) do
    ApplyESP(p)
end
Players.PlayerAdded:Connect(ApplyESP)

ESPHighlightToggle:OnChanged(function(Value)
